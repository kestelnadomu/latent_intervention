!models/talent/*/g-*/h-oracle_regression/latent_intervention.info.json
# h_Z benchmark: one predeclared deployment seed per case/run, not every trial.
!models/talent/*/g-*/h-*/
!models/talent/*/g-*/h-*/benchmarks/
!models/talent/*/g-*/h-*/benchmarks/*/
!models/talent/*/g-*/h-*/benchmarks/*/selected/
!models/talent/*/g-*/h-*/benchmarks/*/selected/latent_intervention.pt
!models/talent/*/g-*/h-*/benchmarks/*/selected/latent_intervention.info.json

